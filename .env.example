# URL where Alertmanager sends alert webhooks (any HTTP receiver).
# Default (leave unset): http://host.docker.internal:8080/alert, a receiver
# listening on port 8080 of your machine.
# Test without any receiver: set COMPOSE_PROFILES=echo (below) and
#   WEBHOOK_RECEIVER_URL=http://alert-echo:8080/alert
# then read the alerts with: docker compose logs -f alert-echo
# Optional hosted alternative: https://webhook.site/your-test-id
# Caveat: payloads contain device names and IP addresses and would be sent to
# a public third-party site. Do not use it with real networks.
WEBHOOK_RECEIVER_URL=

# Compose profiles to enable. `echo` adds the alert-echo container (a test
# receiver that prints alerts to its logs, published on http://localhost:8081).
# COMPOSE_PROFILES=echo

# Loki URL for Grafana datasource.
# Split mode (primary): Alloy+Loki run on the VM, Grafana queries it remotely.
# Set before running `make up` on the laptop. Default: http://10.10.20.15:3100
LOKI_URL=http://10.10.20.15:3100

# Static IPs for gnp-stack containers on the XRd macvlan network (10.10.20.0/24).
# Only needed for `make up-vm` (full-VM mode).
# Must not conflict with XRd devices (101-108), VM host (15), or gateway (254).
ALLOY_MACVLAN_IP=10.10.20.11
GRAFANA_MACVLAN_IP=10.10.20.12
